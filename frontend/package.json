{
  "name": "onbt-frontend",
  "version": "1.0.0",
  "description": "ONBT Omnichain Ecosystem - Web3 Frontend",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const v = process.versions.node; const [major, minor] = v.split('.').map(Number); if (major < 22 || (major === 22 && minor < 11)) { console.error('Error: Node 22.11.0+ required (current: ' + v + ')'); process.exit(1); }\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "cypress run --headless --browser chrome"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.0",
    "classnames": "^2.3.2",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.1",
    "date-fns": "^3.6.0",
    "ethereum-blockies-base64": "^1.0.2",
    "ethers": "^5.7.2",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.298.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-confetti": "^6.1.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-countdown": "^2.3.5",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^9.0.1",
    "react-use": "^17.6.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.1",
    "use-sound": "^4.0.1",
    "vaul": "^0.9.0",
    "viem": "^2.23.0",
    "wagmi": "^2.12.0",
    "zod": "^3.25.76",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.2.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "cypress": "^15.10.0",
    "eslint": "^8.57.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "3.1.3"
    },
    "@eslint/eslintrc": {
      "minimatch": "3.1.3"
    },
    "@humanwhocodes/config-array": {
      "minimatch": "3.1.3"
    },
    "glob@7.2.3": {
      "minimatch": "3.1.3"
    }
  }
}
