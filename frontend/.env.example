# ============================================
# WALLET & RPC CONFIGURATION
# ============================================

# SECURITY: Frontend env variables are public at build/runtime.
# Never place PRIVATE_KEY, MNEMONIC, SEED_PHRASE, API secrets, or bearer tokens here.

# Wallet Connect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# RPC URLs - Configure with Alchemy, Infura, or other providers for production
# Base Mainnet (Chain ID: 8453)
VITE_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Arbitrum One (Chain ID: 42161)
VITE_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Base Sepolia (Testnet)
VITE_BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Ethereum Mainnet
VITE_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Public fallback RPCs (used if above are not configured):
# Base: https://mainnet.base.org
# Arbitrum: https://arb1.arbitrum.io/rpc

# ============================================
# BLOCK EXPLORER APIs
# ============================================

# Public block explorer URLs should be used from app config.
# Do not put explorer API secrets in frontend env.

# ============================================
# PINATA IPFS CONFIGURATION
# ============================================

# Public gateway only (no credentials in frontend)
VITE_PINATA_GATEWAY=harlequin-adjacent-bovid-525.mypinata.cloud

# ============================================
# BACKEND APIs
# ============================================

# Backend API endpoints
VITE_API_BASE_URL=http://localhost:3001
VITE_BACKEND_URL=http://localhost:3002

# ============================================
# BRANDING
# ============================================

# ONBT Branding (optional overrides)
VITE_ONBT_LOGO_URI=ipfs://bafybeiathkcuucabxdrikkk7ew5hryc7bapldu2winwelohc3n6nuuwdwy
VITE_ONBT_WEBSITE=https://nabat.finance
VITE_ONBT_DESCRIPTION=Omnichain Nabat (ONBT) is an immutable omnichain fungible token

# ============================================
# FEATURE FLAGS
# ============================================

# Enable testnet support
VITE_ENABLE_TESTNET=false

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=true

# Enable debug mode (verbose console logging)
VITE_ENABLE_DEBUG=false
