{
  "name": "onbt-miniapp",
  "version": "1.0.0",
  "description": "ONBT DeFi Miniapp - Private Sale, Bridge, Staking, and Governance",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/punycode-resolver.cjs ./node_modules/next/dist/bin/next dev",
    "dev:host": "next dev -H 0.0.0.0 -p 3000",
    "clean": "node scripts/clean-next.mjs",
    "prebuild": "node scripts/clean-next.mjs && npm run type-check && npm run lint",
    "build": "node --require ./scripts/punycode-resolver.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/punycode-resolver.cjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint . --ext .ts,.tsx",
    "check": "npm run type-check && npm run lint",
    "verify": "npm run check && npm run rate:app:quick",
    "minikit:manifest": "create-onchain --manifest",
    "minikit:scaffold": "create-onchain --mini",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "rate:app": "node scripts/rate-app.mjs",
    "rate:app:quick": "node scripts/rate-app.mjs --quick",
    "rate:app:ci": "node scripts/rate-app.mjs --ci",
    "advance:miniapp": "node scripts/advance-miniapp.mjs",
    "advance:miniapp:quick": "node scripts/advance-miniapp.mjs --quick",
    "advance:miniapp:fix": "node scripts/advance-miniapp.mjs --fix",
    "advance:miniapp:ci": "node scripts/advance-miniapp.mjs --ci --strict",
    "postinstall": "node scripts/fix-punycode-deprecation.mjs"
  },
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@coinbase/onchainkit": "^1.1.2",
    "@tanstack/react-query": "^5.0.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.47.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "hono": "^4.12.5",
    "graphql-request": "^7.4.0",
    "@walletconnect/sign-client": "^2.23.7",
    "@walletconnect/universal-provider": "^2.23.7",
    "@walletconnect/ethereum-provider": "^2.23.7",
    "@paulmillr/qr": "npm:qr@^0.5.4"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=9.0.0"
  }
}
