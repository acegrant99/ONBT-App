# Add these to your existing .env file for multi-chain deployments

# ========================================
# RPC URLs for New Networks
# ========================================

# Optimism
OPTIMISM_RPC_URL=https://mainnet.optimism.io
# Or use Infura: https://optimism-mainnet.infura.io/v3/YOUR_KEY
# Or use Alchemy: https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com
# Or use Infura: https://polygon-mainnet.infura.io/v3/YOUR_KEY
# Or use Alchemy: https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# BSC (Binance Smart Chain)
BSC_RPC_URL=https://bsc-dataseed1.binance.org
# Alternatives: https://bsc-dataseed2.binance.org, https://bsc-dataseed3.binance.org

# Avalanche C-Chain
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Or use Infura: https://avalanche-mainnet.infura.io/v3/YOUR_KEY

# ========================================
# Explorer API Keys for Verification
# ========================================

# Optimism Etherscan
# Get from: https://optimistic.etherscan.io/myapikey
OPTIMISM_API_KEY=your_optimism_api_key_here

# PolygonScan
# Get from: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# BscScan
# Get from: https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Snowtrace (Avalanche)
# Get from: https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=your_snowtrace_api_key_here

# ========================================
# Optional: Premium RPC Provider Keys
# ========================================

# Infura (supports multiple networks)
# Get from: https://infura.io
# INFURA_API_KEY=your_infura_key

# Alchemy (supports Optimism, Polygon, Ethereum)
# Get from: https://alchemy.com
# ALCHEMY_API_KEY=your_alchemy_key

# QuickNode (supports all networks)
# Get from: https://quicknode.com
# QUICKNODE_ENDPOINTS...

# ========================================
# Notes
# ========================================
# - Public RPCs (like polygon-rpc.com) work but may be slower/less reliable
# - For production, use Infura, Alchemy, or QuickNode
# - Keep API keys private - never commit .env file to Git
# - You only need ONE RPC provider (Infura OR Alchemy OR QuickNode)
