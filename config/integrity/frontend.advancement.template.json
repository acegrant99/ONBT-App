{
  "component": "frontend-advancement",
  "qualityGates": {
    "typescriptStrict": true,
    "lintZeroWarnings": true,
    "accessibilityRequired": true,
    "bundleBudgetKb": 350
  },
  "walletSupport": {
    "requiredChains": [
      "base",
      "arbitrum"
    ],
    "enforceChainSwitchGuard": true,
    "transactionSimulation": true
  },
